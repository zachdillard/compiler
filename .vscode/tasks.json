{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build parser.cs",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/concepts/parser.cs",
        "--output",
        "${workspaceFolder}/obj/parser-debug"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build compiler.cs",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/concepts/compiler.cs",
        "--output",
        "${workspaceFolder}/obj/compiler-debug"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
